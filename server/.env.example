# Required if using Google Gemini. Keep keys private in server/.env.
GEMINI_API_KEY=replace_with_your_gemini_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional providers. Add only the providers you intend to use.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional OpenAI-compatible base URL; defaults to https://api.openai.com/v1/chat/completions
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional custom Anthropic endpoint; defaults to https://api.anthropic.com/v1/messages
ANTHROPIC_BASE_URL=

# Provider routing. Auto uses fast for simpler/shorter posts and quality for complex posts.
AI_DEFAULT_PROVIDER=gemini
AI_FAST_PROVIDER=gemini
AI_QUALITY_PROVIDER=gemini
# Optional model overrides for automatic routing.
AI_FAST_MODEL=
AI_QUALITY_MODEL=

PORT=8787
MODEL_TIMEOUT_MS=45000
RATE_LIMIT_PER_MINUTE=20
CACHE_TTL_MS=1800000
CACHE_MAX_ENTRIES=200

# Hard cap on AI model-call attempts per UTC day. Cache hits don't consume it.
DAILY_MODEL_CALL_LIMIT=50

# Required to start the backend: the ID shown at chrome://extensions.
# This is a CORS guardrail, not authentication against other local applications.
EXTENSION_ID=

# Optional provider-specific input/output rates, USD per 1M tokens.
GEMINI_INPUT_USD_PER_1M_TOKENS=
GEMINI_OUTPUT_USD_PER_1M_TOKENS=
OPENAI_INPUT_USD_PER_1M_TOKENS=
OPENAI_OUTPUT_USD_PER_1M_TOKENS=
ANTHROPIC_INPUT_USD_PER_1M_TOKENS=
ANTHROPIC_OUTPUT_USD_PER_1M_TOKENS=
# Generic rates are used only when a provider-specific rate is blank.
AI_INPUT_USD_PER_1M_TOKENS=
AI_OUTPUT_USD_PER_1M_TOKENS=

# Evaluation script calls your local backend. Keep the number small to control cost.
EVAL_BASE_URL=http://127.0.0.1:8787
EVAL_MAX_CASES=4
