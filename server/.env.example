GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=8787
MODEL_TIMEOUT_MS=45000
RATE_LIMIT_PER_MINUTE=20
CACHE_TTL_MS=1800000
CACHE_MAX_ENTRIES=200

# Recommended: set this to the 32-character ID shown at chrome://extensions.
# When blank, the local server accepts requests from any valid Chrome extension origin.
EXTENSION_ID=

# Optional paid-tier token rates, USD per 1 million tokens.
# Leave blank for free-tier usage or when you do not want a cost estimate.
# Check current Google AI Studio pricing and your billing tier before setting these.
GEMINI_INPUT_USD_PER_1M_TOKENS=
GEMINI_OUTPUT_USD_PER_1M_TOKENS=
