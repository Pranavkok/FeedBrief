GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=8787
MODEL_TIMEOUT_MS=45000
RATE_LIMIT_PER_MINUTE=20
CACHE_TTL_MS=1800000
CACHE_MAX_ENTRIES=200

# Hard limit on Gemini API call attempts per UTC day. Set 0 for unlimited.
# Cache hits do not consume this limit. Daily aggregate usage is saved locally in server/data/.
DAILY_MODEL_CALL_LIMIT=50

# Required to start the backend: set the ID shown at chrome://extensions.
# This is a CORS guardrail, not authentication against other local applications.
EXTENSION_ID=

# Optional paid-tier token rates, USD per 1 million tokens.
# Check current Google AI Studio pricing and your billing tier before setting these.
GEMINI_INPUT_USD_PER_1M_TOKENS=
GEMINI_OUTPUT_USD_PER_1M_TOKENS=
