{
  "manifest_version": 3,
  "name": "LinkedIn TL;DR \u2014 Private Prototype",
  "version": "0.2.0",
  "description": "Summarize text you explicitly paste into the extension.",
  "action": {
    "default_title": "LinkedIn TL;DR",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ]
}