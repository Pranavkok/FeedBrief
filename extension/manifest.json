{
  "manifest_version": 3,
  "name": "LinkedIn TL;DR — Private Prototype",
  "version": "0.5.0",
  "description": "Summarize text you explicitly paste, save private history, and track local usage.",
  "action": {
    "default_title": "LinkedIn TL;DR",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8787/*"]
}
