{
  "manifest_version": 3,
  "name": "LinkedIn TL;DR — Post Summarizer",
  "version": "0.9.0",
  "description": "Summarize text you choose with a locally configured AI provider. Paste-only; no LinkedIn page access.",
  "minimum_chrome_version": "102",
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LinkedIn TL;DR",
    "default_popup": "popup.html",
    "default_icon": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open LinkedIn TL;DR"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8787/*"]
}
